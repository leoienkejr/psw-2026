# Copie este arquivo para .env e ajuste os valores conforme necessário.
# O .env real não é versionado no git (está no .gitignore).

# Porta em que o servidor Express escuta
PORT=3000

# Chave da API do TMDB (opcional, usada pelo endpoint /tmdb/search).
# Crie uma conta em https://www.themoviedb.org/settings/api para obter a sua.
TMDB_API_KEY=sua-chave-aqui
